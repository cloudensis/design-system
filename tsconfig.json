{
	"compilerOptions": {
		"target": "es2024",
		"lib": ["es2024"],
		"module": "preserve",
		"moduleResolution": "bundler",
		"types": ["vite/client"],
		"strict": true,
		"noEmit": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"jsx": "react-jsx",
		"jsxImportSource": "hono/jsx",
		"allowImportingTsExtensions": true,
		"rewriteRelativeImportExtensions": true
	},
	"include": ["src", "docs", "*.config.ts", ".cloudflare/types"]
}
