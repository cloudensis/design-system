{
	"compilerOptions": {
		"target": "es2024",
		"lib": ["es2024"],
		"module": "preserve",
		"moduleResolution": "bundler",
		"types": ["vite/client"],
		"strict": true,
		"noEmit": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"jsx": "react-jsx",
		"jsxImportSource": "hono/jsx",
		"allowImportingTsExtensions": true,
		"rewriteRelativeImportExtensions": true,
		/* ドキュメントサイトから、配布物と同じパスでソースを import する。vite.config.ts の alias と合わせる。 */
		"paths": {
			"@cloudensis/design-system/components/*": ["./src/components/*.tsx"],
			"@cloudensis/design-system/icons/*": ["./src/icons/*.tsx"],
			"@cloudensis/design-system/brand/*": ["./src/brand/*.tsx"],
			"@cloudensis/design-system/lib/*": ["./src/lib/*.ts"]
		}
	},
	"include": ["src", "docs", "*.config.ts", ".cloudflare/types"]
}
