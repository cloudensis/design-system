{
	"name": "@cloudensis/design-system",
	"version": "0.12.0",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cloudensis/design-system.git"
	},
	"type": "module",
	"files": [
		"dist",
		"src/styles",
		"src/assets"
	],
	"exports": {
		"./colors.css": "./src/styles/colors.css",
		"./typography.css": "./src/styles/typography.css",
		"./fonts.css": "./src/styles/fonts.css",
		"./components/*": {
			"types": "./dist/components/*.d.ts",
			"default": "./dist/components/*.js"
		},
		"./lib/utils": {
			"types": "./dist/lib/utils.d.ts",
			"default": "./dist/lib/utils.js"
		},
		"./assets/*": "./src/assets/*"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"typecheck": "tsc",
		"dev": "vite",
		"build:docs": "vite build"
	},
	"peerDependencies": {
		"hono": "^4.13.8",
		"tailwindcss": "^4.3.3"
	},
	"dependencies": {
		"@fontsource-variable/noto-sans-jp": "^5.3.0",
		"@fontsource-variable/outfit": "^5.3.0",
		"clsx": "^2.1.1",
		"tailwind-merge": "^3.7.0"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.60.0",
		"@tailwindcss/vite": "^4.3.3",
		"hono": "^4.13.8",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.1",
		"wrangler": "^4.139.0"
	}
}
