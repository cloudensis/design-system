{
	"name": "@cloudensis/design-system",
	"version": "0.14.4",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cloudensis/design-system.git"
	},
	"type": "module",
	"files": [
		"dist",
		"src/styles",
		"src/assets"
	],
	"exports": {
		"./index.css": "./src/styles/index.css",
		"./base.css": "./src/styles/base.css",
		"./colors.css": "./src/styles/colors.css",
		"./typography.css": "./src/styles/typography.css",
		"./fonts.css": "./src/styles/fonts.css",
		"./prose.css": "./src/styles/prose.css",
		"./radius.css": "./src/styles/radius.css",
		"./reset.css": "./src/styles/reset.css",
		"./components.css": "./dist/components.css",
		"./components/*": {
			"types": "./dist/components/*.d.ts",
			"default": "./dist/components/*.js"
		},
		"./brand/*": {
			"types": "./dist/brand/*.d.ts",
			"default": "./dist/brand/*.js"
		},
		"./icons/*": {
			"types": "./dist/icons/*.d.ts",
			"default": "./dist/icons/*.js"
		},
		"./lib/highlight": {
			"types": "./dist/lib/highlight.d.ts",
			"default": "./dist/lib/highlight.js"
		},
		"./lib/utils": {
			"types": "./dist/lib/utils.d.ts",
			"default": "./dist/lib/utils.js"
		},
		"./assets/*": "./src/assets/*"
	},
	"scripts": {
		"build": "rm -rf dist && vite build && tsc -p tsconfig.build.json",
		"typecheck": "tsc && tsc -p tests",
		"dev": "vite -c vite.docs.config.ts",
		"build:docs": "vite build -c vite.docs.config.ts && node scripts/ssg.ts",
		"lint": "biome check",
		"format": "biome check --write --unsafe",
		"test:a11y": "playwright test"
	},
	"peerDependencies": {
		"hono": "^4.13.13"
	},
	"dependencies": {
		"@fontsource-variable/noto-sans-jp": "^5.3.1",
		"@fontsource-variable/outfit": "^5.3.0",
		"@shikijs/langs": "^4.5.0",
		"@shikijs/themes": "^4.5.0",
		"clsx": "^2.1.1",
		"shiki": "^4.5.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@biomejs/biome": "^2.6.3",
		"@hono/vite-dev-server": "^0.26.1",
		"@playwright/test": "^1.64.1",
		"@types/node": "^26.6.5",
		"cf": "^1.0.0-beta.23",
		"hono": "^4.13.14",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"wrangler": "^4.153.0"
	}
}
