{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"formatter": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"nursery": {
				"useSortedClasses": {
					"level": "on",
					"options": {
						"functions": ["cn"]
					}
				}
			}
		}
	},
	"assist": {
		"enabled": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": ["**", "!.claude", "!node_modules"]
	}
}
