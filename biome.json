{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"formatter": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"a11y": {
				"noLabelWithoutControl": {
					"level": "on",
					"options": {
						"inputComponents": ["Input", "Select", "Textarea"]
					}
				}
			},
			"nursery": {
				"useTailwindSortedClasses": "warn"
			}
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"assist": {
		"enabled": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!node_modules",
			"!dist",
			"!docs-dist",
			"!.wrangler",
			"!.cloudflare",
			"!test-results",
			"!playwright-report"
		]
	}
}
